# Frontend (Vite) — public only. Never put server secrets in VITE_* vars.
VITE_API_BASE_URL=http://localhost:8787

# Wave 1 domain cutover (local | api, case insensitive). Defaults to local when unset.
VITE_CUTOVER_AUTH=local
VITE_CUTOVER_CLIENTS=local
VITE_CUTOVER_STAFF=local

# Legacy global override (Wave 0). Prefer VITE_CUTOVER_* per domain.
VITE_DATA_MODE=local

# Optional legacy Gemini browser key (remove in Wave 11; server proxy then).
# GEMINI_API_KEY=
