    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.3",
    "typescript": "~5.8.2",
    "vitest": "^3.2.4"
  }
}
